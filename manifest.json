{
  "manifest_version": 3,
  "name": "Email Writer Extension",
  "version": "1.0",
  "description": "Injects an AI reply button into Gmail compose window.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
